+    size_t offset = 0;
+    while (offset < bytes) {
+        if (probe_cancel_requested()) return false;
+        const size_t chunk = std::min<size_t>(bytes - offset, 1024 * 1024);
+        if (fread(output + offset, 1, chunk, file) != chunk) return false;
+        offset += chunk;
+    }
+    return !probe_cancel_requested();
+}
 
